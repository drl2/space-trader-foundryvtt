<div class="st-chatcard">
    <span style="font-weight: bold">{{localize 'SPACE-TRADER.SpecGoodsAvailable'}}</span>
    <br />


    <table>
        <tr>
            <th>{{localize 'SPACE-TRADER.Goods'}}</th>
            <th style="width:35px">{{localize 'SPACE-TRADER.Tons'}}</th>
            <th style="text-align:right">{{localize 'SPACE-TRADER.CostCr'}}</th>
        </tr>
        {{#each tradeGoods}}
            <tr>
                <td>{{localize (concat 'SPACE-TRADER.TRADEGOODNAMES.' this.type)}}</td>
                <td>{{{this.tons}}}</td>
                <td style="text-align:right;{{ifThen (eq this.relativeValue -1) 'color:green;' ''}}{{ifThen (eq this.relativeValue 1) 'color:red;' ''}}">{{{this.sell}}}</td>
            </tr>
        {{/each}}
    </table>

</div>

