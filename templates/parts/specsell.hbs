<div class="space-trader-specsell-page">
    <div class="space-trader-twelvept-text">
        <label style="font-weight: bold;">{{localize "SPACE-TRADER.SPECTRADEROLLS.FindBuyer"}}:</label><br />
        <label>{{localize "SPACE-TRADER.SPECTRADEROLLS.FindBuyerRoll"}}</label><br />
        <br />
        <label style="font-weight: bold;">{{localize "SPACE-TRADER.SPECTRADEROLLS.FindBlackMarketBuyer"}}:</label><br />
        <label>{{localize "SPACE-TRADER.SPECTRADEROLLS.FindBlackMarketBuyerRoll"}}</label><br />
        <br />
        <label style="font-weight: bold;">{{localize "SPACE-TRADER.SPECTRADEROLLS.FindOnlineBuyer"}}:</label><br />
        <label>{{localize "SPACE-TRADER.SPECTRADEROLLS.FindOnlineBuyerRoll"}}</label><br />
        <br />
        <label style="font-weight: bold;">{{localize "SPACE-TRADER.PreviousTryPenalty"}}</label><br />
        <br />
        <label style="font-weight: bold;">{{starportDM}}</label>
    </div>
    <div>

        <div class="space-trader-spec-buttondiv">
            <div class="space-trader-lower-text">
                <label class="space-trader-lower-text">{{localize "SPACE-TRADER.Legality"}}:</label>
                <select name="specSell.isLegal" value="specSell.isLegal" class="space-trader-specsell-islegal">
                    {{selectOptions LEGAL selected=specSell.isLegal localize=true}}
                </select>
            </div>
            <div>
                <button class="specsell-get-button space-trader-get-button"
                    title="{{localize 'SPACE-TRADER.GetSalePrices'}}">
                    {{localize 'SPACE-TRADER.GetSalePrices'}}</button>
            </div>
        </div>

        <div class="space-trader-specbuy-list">
            <div class="{{ifThen specSell.isLegal 'space-trader-specbuy-detail' 'space-trader-specsell-illegal-detail'}}">
                <div>&nbsp;</div>
                <div class="space-trader-column-header">{{localize 'SPACE-TRADER.Type'}}</div>
                <div class="space-trader-column-header">{{localize 'SPACE-TRADER.Tons'}}</div>
                {{#unless specSell.isLegal}}
                    <div class="space-trader-column-header">{{localize 'SPACE-TRADER.LLDiff'}}</div>
                {{/unless}}
                <div class="space-trader-column-header">{{localize 'SPACE-TRADER.BoughtPriceCr'}}</div>
                <div class="space-trader-column-header">{{localize 'SPACE-TRADER.OfferCr'}}</div>


                {{#each specSellList}}
                <div>
                    <a class="item-control buy purchase-spec" data-rolltype="sell" data-id="{{@this.key}}"
                        title="{{localize 'SPACE-TRADER.Sell'}}">
                        <i class="fas fa-dollar-sign"></i>
                    </a>
                </div>
                <div>{{{this.name}}}</div>
                <div>{{{this.tons}}}</div>
                {{#unless ../specSell.isLegal}}
                    <div>{{this.llDiff}}</div>
                {{/unless}}
                <div>{{{this.purchasePrice}}}</div>
                <div
                    style="{{ifThen (eq this.relativeValue -1) 'color:green;' ''}}{{ifThen (eq this.relativeValue 1) 'color:red;' ''}}">
                    {{{this.offer}}}</div>
                {{/each}}

            </div>

        </div>
    </div>