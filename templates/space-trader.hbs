{{log "space-trader-template" this}}
<div class="flexrow" autocomplete="off">
    <div class="space-trader-trades-column">
        <div>
            <nav class="sheet-tabs tabs" data-group="sheet">
                {{#each tabs.sheet.tabs}}
                <a class="item" data-tab="{{this.id}}" {{#if @first}}data-active="true"{{/if}}>
                    {{localize this.label}}
                </a>
                {{/each}}
            </nav>
            <section class="tab-content">
                {{{parts.settings}}}
                {{{parts.passengers}}}
                {{{parts.freight}}}
                {{{parts.specbuy}}}
                {{{parts.specsell}}}
            </section>
        </div>
    </div>
</div>